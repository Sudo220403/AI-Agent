# Google Gemini API Key (Required for live LLM extraction; falls back to deterministic heuristic/mock mode if unset during testing)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Alpha Vantage API Key (Get a free key at https://www.alphavantage.co/support/#api-key)
# Can also use "demo" for IBM/MSFT demo endpoints or automatic fallback cache
ALPHAVANTAGE_API_KEY=demo

# LangSmith Observability (Optional - native LangGraph tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=finagent-reliable-prod

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=finagent-langgraph-agent
OTEL_TRACES_EXPORT_PATH=logs/otel_traces.jsonl
